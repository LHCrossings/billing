          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSetCustomer">
      <Query>
        <DataSourceName>PrepostTelecast_DataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@idcustomer">
            <Value>=Parameters!idcustomer.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>if (@idcustomer&gt;0)
	select rag_social as customer from anagraf with(nolock) where id_anagraf=@idcustomer
else
	select '' as customer</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="customer">
          <DataField>customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
