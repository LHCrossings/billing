<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="PrepostTelecast_DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=EC2AMAZ-6J2KLLI;Initial Catalog=Etere_crossing</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>56961c2c-554f-495d-9a59-d5be1cc7e0e9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="preposttelecast_DataSet">
      <Query>
        <DataSourceName>PrepostTelecast_DataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@cod_user">
            <Value>=Parameters!cod_user.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@from">
            <Value>=Parameters!from.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@to">
            <Value>=Parameters!to.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@idcustomer">
            <Value>=Parameters!idcustomer.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@idcontract">
            <Value>=Parameters!idcontract.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@idbooking">
            <Value>=Parameters!idbooking.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>set datefirst 1 --imposta il primo giorno della settimana.
select SS.* from (
select ttp.id_contrattirighe,
a.RAG_SOCIAL as company,ttp.Data as date,cr.datestart,dbo.Env_Translate(left(DATENAME(dw,ttp.data),3)) as dayweek,dbo._fn_hm(ttp.ora,dbo.getVideoStandard(@cod_user)) as airtime,
					dbo._fn_hm(ttp.ora_p,dbo.getVideoStandard(@cod_user)) as airtimep,
					ct.DESCRIZIONE as contractdesc,ct.cod_contratto as codcontract,bc.code as spottype,u.nome as station,
					dbo._FramesToSec(ttp.duration,dbo.getVideoStandard(@cod_user)) as duration,
					cr.DESCRIZIONE as detail,cr.IMPORTO as price,dbo.trf_GetSpotType(ttp.ID_ContrattiRighe,2) as spotdescritpion,
					dbo.rpt_trf_getbatchReference(ttp.id_contrattirighe,ttp.data) as booking,
					  a.TIPO_CLI,
					  a.RAG_SOCIAL,
                      dbo._fn_hm(cr.ORA_INIZIOF,dbo.getVideoStandard(cr.COD_USER)) timefrom,
                      dbo._fn_hm(cr.ORA_FINEF,dbo.getVideoStandard(cr.COD_USER)) timeto,
			dbo.Trf_GetEventScheduleType(cr.id_contrattirighe) rowtype,ttp.xorder as xorder
			,datepart(week, ttp.Data) weeknr
			,cr.N_PASSAGGI as toschedule
, dbo.NullToZero(dbo.NREVENTSCHED(dbo.trf_getMasterOrderID(CT.id_contrattitestata,CR.ID_CONTRATTIRIGHE),CR.cod_user)) Programmati 
, (dbo.GetTotaleBlackWhiteList(dbo.trf_getMasterOrderID(CT.id_contrattitestata,CR.ID_CONTRATTIRIGHE), 0) +
 dbo.GetTotaleBlackWhiteList(dbo.trf_getMasterOrderID(CT.id_contrattitestata,CR.ID_CONTRATTIRIGHE), 1) ) totunplaced,
  (DATEADD(dd, 0 - (@@DATEFIRST + 5 + DATEPART(dw, ttp.Data)) % 7, ttp.Data)) AS WeekStartDate,
  (DATEADD(dd, 6 - (@@DATEFIRST + 5 + DATEPART(dw, ttp.Data)) % 7, ttp.Data) ) AS WeekEndDate


					from trafficTPalinse ttp with(nolock)
					join contrattirighe cr with(nolock) on cr.id_contrattirighe=ttp.id_contrattirighe
					join contrattitestata ct with(nolock) on ct.id_contrattitestata=cr.id_contrattitestata
					left join Users u with(nolock) on u.cod_user=ttp.Cod_User
					left join Traffic_Block tb with(nolock) on tb.ID_TrafficBlock=ttp.ID_TrafficBlock
					left join ANAGRAF a with(nolock) on a.ID_ANAGRAF=ct.COMMITTENTE
					left join Traffic_ScheduleBlock tsb with(nolock) on tsb.ID_TrafficBlock=ttp.ID_TrafficBlock and tsb.ID_TrafficSchedule=ttp.ID_TrafficSchedule
					left join filmati f with(nolock) on f.id_filmati=ttp.id_filmati
					left join trf_bookingcode bc with(nolock) on bc.id_bookingcode=cr.id_bookingcode
					where ttp.Data&gt;=@from and ttp.Data&lt;=@to
					and ttp.Cod_User=@cod_user
					and (ct.committente=@idcustomer or @idcustomer=-1)
					and (ct.id_contrattitestata=@idcontract or @idcontract=-1)
					and (cr.id_contrattirighe=@idbooking or @idbooking=-1)
					and ttp.livello=0
					and ttp.eventtype=0
					) SS
					order by ss.date,ss.airtime,ss.id_contrattirighe,ss.xorder</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="company">
          <DataField>company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="id_contrattirighe">
          <DataField>id_contrattirighe</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="date">
          <DataField>date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="dayweek">
          <DataField>dayweek</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="datestart">
          <DataField>datestart</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="airtime">
          <DataField>airtime</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="contractdesc">
          <DataField>contractdesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="airtimep">
          <DataField>airtimep</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="spottype">
          <DataField>spottype</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="codcontract">
          <DataField>codcontract</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="station">
          <DataField>station</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="duration">
          <DataField>duration</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="detail">
          <DataField>detail</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="price">
          <DataField>price</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="spotdescritpion">
          <DataField>spotdescritpion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="booking">
          <DataField>booking</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TIPO_CLI">
          <DataField>TIPO_CLI</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RAG_SOCIAL">
          <DataField>RAG_SOCIAL</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="timefrom">
          <DataField>timefrom</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="timeto">
          <DataField>timeto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rowtype">
          <DataField>rowtype</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="xorder">
          <DataField>xorder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="weeknr">
          <DataField>weeknr</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Programmati">
          <DataField>Programmati</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="toschedule">
          <DataField>toschedule</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="totunplaced">
          <DataField>totunplaced</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="WeekStartDate">
          <DataField>WeekStartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="WeekEndDate">
          <DataField>WeekEndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="parameter_DataSet">
      <Query>
        <DataSourceName>PrepostTelecast_DataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@cod_user">
            <Value>=Parameters!cod_user.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
					SELECT     logoimage, terms
					FROM         trf_userparameters
					WHERE     (coduser = @cod_user)
				</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="logoimage">
          <DataField>logoimage</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
        <Field Name="terms">
          <DataField>terms</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
