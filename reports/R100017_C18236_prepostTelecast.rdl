    <DataSet Name="UserList">
      <Query>
        <DataSourceName>PrepostTelecast_DataSource</DataSourceName>
        <CommandText>select distinct cod_user, nome from users</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="cod_user">
          <DataField>cod_user</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="nome">
